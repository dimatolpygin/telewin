# Шаблон переменных окружения. Скопировать в .env и заполнить:
#   cp .env.example .env
#
# ВНИМАНИЕ: репозиторий публичный. Файл .env в .gitignore — реальные значения
# сюда не вписывать, они живут только в .env и в GitHub Secrets.

# --- Приложение ---
# Порт HTTP-сервера внутри контейнера
APP_PORT=
# Уровень логов: trace | debug | info | warn | error | fatal
LOG_LEVEL=
# development | production
NODE_ENV=

# --- Postgres ---
# Значения ниже использует и контейнер postgres, и приложение
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Хост и порт Postgres для инструментов, запускаемых С ХОСТА: drizzle-kit и CLI price:*.
# Приложению внутри compose эти значения не достаются — там жёстко postgres:5432.
#
# ВАЖНО: ставить localhost:5432 нельзя, если на машине уже крутится другой постгрес
# (частый случай — локальная Supabase). Тогда инструменты молча уйдут в ЧУЖУЮ базу:
# на этапе 2 так и вышло, и db:migrate с хоста поехал бы создавать таблицы telewin
# в постороннем сервере. Порт должен совпадать с POSTGRES_PORT_HOST ниже.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis ---
# То же самое: значения для хоста, приложение внутри compose ходит на redis:6379
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Порты, пробрасываемые на хост ---
# Не 5432/6379, потому что штатные порты на машине разработчика обычно заняты.
# Слушают только 127.0.0.1 — наружу базу отдавать нельзя.
POSTGRES_PORT_HOST=5433
REDIS_PORT_HOST=6380

# --- Источник прайса (этап 3, забор) ---
# Откуда бот берёт файл. ftp — боевой сервер приёма, local — папка на диске
# (разработка или «файл кладут рядом»). Смена источника — правка ТОЛЬКО этих
# переменных, кода не касается.
PRICE_SOURCE=ftp

# Реквизиты FTP — значения в доступы.txt / docs/ACCESSES.md, сюда НЕ вписывать.
PRICE_FTP_HOST=
PRICE_FTP_PORT=21
PRICE_FTP_USER=
PRICE_FTP_PASSWORD=
# false — обычный FTP (у нас так). true — FTPS. SFTP не поддерживается.
PRICE_FTP_SECURE=false
# Папка приёма относительно домашней папки FTP-логина. У нас — price
PRICE_FTP_DIR=price

# Папка для PRICE_SOURCE=local. ВНИМАНИЕ: при включённой авто-очистке
# (PRICE_KEEP_FILES>0) старые файлы отсюда УДАЛЯЮТСЯ — не направлять на samples/.
PRICE_LOCAL_DIR=

# Дебаунс: пауза между двумя замерами размера, мс. Файл считается докачанным,
# если размер за это время не изменился. Боевой прайс 2.4 МБ льётся минутами.
PRICE_STABLE_WAIT_MS=3000

# Авто-очистка источника: сколько свежих файлов оставлять. 0 — не удалять ничего
# (безопасно для разработки). На бою поставить, например, 5.
PRICE_KEEP_FILES=0

# --- OpenRouter: эмбеддинги (этап 5) и чат (этап 6) ---
# Ключ — в доступы.txt (в репозиторий не коммитить). Модель эмбеддингов выбрана
# замером: gemini-embedding-001 проходит и «гвозди сотка», и «крепёж» (см. ADR в PROJECT.md).
# EMBEDDING_DIM обязан совпадать со столбцом vector(N) в БД (миграция 0003).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# --- Авто-перезапуск при правках (только разработка) ---
# Windows и macOS не пробрасывают inotify через bind mount — без опроса
# tsx watch не увидит правку в src/. Пусто = включено (true), на Linux можно false.
CHOKIDAR_USEPOLLING=
# Интервал опроса в миллисекундах. Пусто = 500
CHOKIDAR_INTERVAL=
